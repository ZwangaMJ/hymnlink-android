<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Announcement"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAnnouncement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textCapSentences"
            android:gravity="top|start"
            android:minLines="4"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="Level of importance"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?android:textColorSecondary" />

    <RadioGroup
        android:id="@+id/rgAnnouncementImportance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbAnnNormal"
            android:layout_width="0dp"
            android:layout_weight="1.1"
            android:layout_height="52dp"
            android:text="Normal"
            android:button="@null"
            android:background="@drawable/bg_urgency_normal_selector"
            android:gravity="center"
            android:checked="true"
            android:textColor="?android:textColorPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <RadioButton
            android:id="@+id/rbAnnUrgent"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:text="Urgent"
            android:button="@null"
            android:background="@drawable/bg_urgency_urgent_selector"
            android:gravity="center"
            android:textColor="?android:textColorPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="4dp" />

        <RadioButton
            android:id="@+id/rbAnnHigh"
            android:layout_width="0dp"
            android:layout_weight="1.4"
            android:layout_height="52dp"
            android:text="High Importance"
            android:button="@null"
            android:background="@drawable/bg_urgency_high_selector"
            android:gravity="center"
            android:textColor="?android:textColorPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp" />
    </RadioGroup>
</LinearLayout>
