<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="?android:windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Back & Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="?android:textColorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Schedule event"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-light" />
        </LinearLayout>

        <!-- Urgency Level Selection Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Urgency level"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?android:textColorSecondary"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <RadioGroup
                android:id="@+id/rgUrgencyLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbNormal"
                    android:layout_width="0dp"
                    android:layout_weight="1.2"
                    android:layout_height="64dp"
                    android:text="Normal"
                    android:button="@null"
                    android:background="@drawable/bg_urgency_normal_selector"
                    android:gravity="center"
                    android:checked="true"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="1dp"
                    android:layout_marginEnd="6dp" />

                <RadioButton
                    android:id="@+id/rbUrgent"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="64dp"
                    android:text="Urgent"
                    android:button="@null"
                    android:background="@drawable/bg_urgency_urgent_selector"
                    android:gravity="center"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="1dp"
                    android:layout_marginHorizontal="3dp" />

                <RadioButton
                    android:id="@+id/rbHighImportance"
                    android:layout_width="0dp"
                    android:layout_weight="1.5"
                    android:layout_height="64dp"
                    android:text="High Importance"
                    android:button="@null"
                    android:background="@drawable/bg_urgency_high_selector"
                    android:gravity="center"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:elevation="1dp"
                    android:layout_marginStart="6dp" />
            </RadioGroup>
        </LinearLayout>

        <!-- Form Fields Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/cardBackgroundColor"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Service Date Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Event Date &amp; Time"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Service Type Dropdown -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilServiceType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Event Type"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                    <AutoCompleteTextView
                        android:id="@+id/actvServiceType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Conductor Selector -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilConductor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Conductor"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                    <AutoCompleteTextView
                        android:id="@+id/actvConductor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Organist Selector -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOrganist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Organist"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                    <AutoCompleteTextView
                        android:id="@+id/actvOrganist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Notes Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Event Notes"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:gravity="top|start"
                        android:lines="3"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSchedule"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Schedule Event"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_rounded_button"
            app:backgroundTint="@null"
            android:layout_marginBottom="40dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
