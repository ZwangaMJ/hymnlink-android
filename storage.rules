rules_version = '2';

// Paste this into the Firebase console: Storage -> Rules -> replace -> Publish.
// (Or deploy with the Firebase CLI: `firebase deploy --only storage`, if you set that up.)
service firebase.storage {
  match /b/{bucket}/o {

    // Admin status lives in the Firestore users collection, so these rules read it from there.
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "ADMIN" &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.approvalStatus == "APPROVED";
    }

    // Sheet music and audio: any signed-in member can read, only admins can upload or remove.
    match /music/{musicId}/{fileName} {
      allow read: if request.auth != null;

      allow create: if isAdmin() &&
        request.resource.size < 50 * 1024 * 1024 &&
        (request.resource.contentType.matches('application/pdf') ||
         request.resource.contentType.matches('image/.*') ||
         request.resource.contentType.matches('audio/.*'));

      allow delete: if isAdmin();
    }
  }
}
